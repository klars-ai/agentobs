# AgentObs hosted deployment (infra/aws/, single EC2 + docker compose).
# Copy to .env on the server. Never commit the filled-in file.

# --- Domain / TLS ---
# Caddy requests a Let's Encrypt certificate for exactly this name, so DNS
# must already resolve to the instance's Elastic IP before first boot -
# otherwise the ACME challenge fails and Caddy retries with backoff.
CADDY_DOMAIN=agents.klars.ai

# Where the frontend is reachable from a clicked email link. Must be set
# explicitly - guessing wrong sends a broken link in a real email that
# cannot be recalled.
APP_BASE_URL=https://agents.klars.ai

# --- Database ---
# Generate: openssl rand -hex 32
POSTGRES_PASSWORD=
POSTGRES_USER=agentobs
POSTGRES_DB=agentobs

# --- Auth ---
# Signs session tokens. Rotating this logs every user out at once.
# Generate: openssl rand -hex 32
JWT_SECRET=

# --- Email (Resend) ---
# Same Resend account and verified klars.ai domain as mobscan; sends from
# noreply@klars.ai. Without this, account emails are not delivered - the
# request still succeeds and is recorded, it just degrades silently, so
# check the logs if a verification email never arrives.
RESEND_API_KEY=

# --- Dashboard access token ---
# Required: the container binds 0.0.0.0 behind Caddy, and the server refuses
# to start on a non-loopback address without this. Anyone with the token can
# read tool inputs and file paths, so treat it as a credential.
# Generate: openssl rand -hex 32
AGENTOBS_DASHBOARD_TOKEN=
